{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krauq.com/schemas/ufo-compatibility-audit-comparison-v2.schema.json",
  "title": "UFO compatibility audit comparison v2",
  "description": "A conservative comparison of two version 2 intake and deep-inspection audit bundles over identical inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "decision",
    "fileCount",
    "inputManifestSha256",
    "counts",
    "baseline",
    "candidate",
    "changes"
  ],
  "properties": {
    "schema": { "const": "com.krauq.ufo.compatibility-audit-comparison" },
    "schemaVersion": { "const": 2 },
    "decision": { "enum": ["pass", "blocked"] },
    "fileCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "inputManifestSha256": { "$ref": "#/$defs/sha256" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unchanged", "improved", "regressed", "review_required"],
      "properties": {
        "unchanged": { "type": "integer", "minimum": 0 },
        "improved": { "type": "integer", "minimum": 0 },
        "regressed": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 }
      }
    },
    "baseline": { "$ref": "#/$defs/snapshot" },
    "candidate": { "$ref": "#/$defs/snapshot" },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "pass" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "regressed": { "const": 0 },
              "review_required": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "blocked" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "counts": {
            "anyOf": [
              { "properties": { "regressed": { "minimum": 1 } } },
              { "properties": { "review_required": { "minimum": 1 } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineVersion", "artifact", "stableResultsSha256"],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "artifact": {
          "oneOf": [
            { "$ref": "#/$defs/launcherArtifact" },
            { "$ref": "#/$defs/containerArtifact" }
          ]
        },
        "stableResultsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "launcherArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "launcher",
        "appImageRoot",
        "appImageTreeSha256",
        "appImageTreeEntries",
        "appImageBytes"
      ],
      "properties": {
        "surface": { "const": "launcher" },
        "launcher": { "type": "string", "minLength": 1 },
        "appImageRoot": { "type": "string", "minLength": 1 },
        "appImageTreeSha256": { "$ref": "#/$defs/sha256" },
        "appImageTreeEntries": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "appImageBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      }
    },
    "containerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "image", "imageId"],
      "properties": {
        "surface": { "const": "container" },
        "image": { "type": "string", "minLength": 1 },
        "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "category", "baseline", "candidate"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "category": { "enum": ["improved", "regressed", "review_required"] },
        "baseline": { "$ref": "#/$defs/resultState" },
        "candidate": { "$ref": "#/$defs/resultState" }
      }
    },
    "resultState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resolvedKind",
        "resolvedFormat",
        "nameAndBytes",
        "probeOutcome",
        "probeLevel",
        "code",
        "warnings",
        "inspection"
      ],
      "properties": {
        "status": { "enum": ["accepted", "limited", "refused", "failed"] },
        "resolvedKind": { "type": ["string", "null"] },
        "resolvedFormat": { "type": ["string", "null"] },
        "nameAndBytes": { "enum": ["match", "mismatch", "unknown", null] },
        "probeOutcome": {
          "enum": [
            "parsed",
            "detected_only",
            "refused",
            "worker_crashed",
            "worker_timed_out",
            "probe_failed",
            "source_changed",
            "not_run"
          ]
        },
        "probeLevel": {
          "enum": ["worker_parsed", "in_process_parsed", "detected_only", "not_run"]
        },
        "code": { "type": ["string", "null"] },
        "warnings": { "$ref": "#/$defs/warnings" },
        "inspection": { "$ref": "#/$defs/stableInspection" }
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": ["name_content_mismatch", "executable_content", "truncated_or_damaged"]
      }
    },
    "stableInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "flags",
        "findings",
        "highestSeverity",
        "textSelectable",
        "container",
        "notInspected"
      ],
      "properties": {
        "status": { "enum": ["completed", "refused", "failed"] },
        "code": { "type": ["string", "null"] },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "type_mismatch",
              "encrypted",
              "has_author",
              "has_properties",
              "has_comments",
              "has_tracked_changes",
              "has_hidden_text",
              "has_speaker_notes",
              "has_hidden_slides",
              "has_hidden_sheets",
              "has_hidden_rows_cols",
              "has_macros",
              "has_embedded_files",
              "has_javascript",
              "has_form_data",
              "has_signatures",
              "has_revision_history",
              "has_hidden_layers",
              "has_external_links",
              "no_text_layer",
              "has_exif",
              "has_xmp",
              "has_iptc",
              "has_thumbnail",
              "has_capture_time",
              "has_gps",
              "has_device_ids",
              "has_trailing_data",
              "has_attachments",
              "header_mismatch",
              "has_nested_archive",
              "has_executable",
              "unsafe_paths",
              "suspicious_expansion",
              "has_hidden_chars",
              "has_bidi_controls",
              "has_pii",
              "has_secrets",
              "has_injection_text"
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableFinding" }
        },
        "highestSeverity": { "enum": ["none", "low", "medium", "high"] },
        "textSelectable": { "type": ["boolean", "null"] },
        "container": {
          "oneOf": [
            { "$ref": "#/$defs/stableContainer" },
            { "type": "null" }
          ]
        },
        "notInspected": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stableFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "severity", "code", "count", "removable"],
      "properties": {
        "category": { "enum": ["privacy", "hidden", "security", "integrity", "info"] },
        "severity": { "enum": ["low", "medium", "high"] },
        "code": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "removable": { "type": ["boolean", "null"] }
      }
    },
    "stableContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "entryCount", "entriesTruncated", "nestedArchives", "executables"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "entryCount": { "type": "integer", "minimum": 0 },
        "entriesTruncated": { "type": "boolean" },
        "nestedArchives": { "type": "integer", "minimum": 0 },
        "executables": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
