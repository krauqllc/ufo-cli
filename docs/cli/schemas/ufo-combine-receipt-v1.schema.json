{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krauq.com/schemas/ufo-combine-receipt-v1.schema.json",
  "title": "UFO combine receipt v1",
  "description": "One `ufo combine` run: every source with its identity and the pages it contributed, the new PDF, and the document-level features no merged file can carry. This is the first receipt with several sources, so `sources` replaces the single `source` object; each entry is hashed before the run and again before the output is published. No source is ever modified and the output never replaces an existing file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "engineVersion",
    "sequence",
    "action",
    "status",
    "sources",
    "output",
    "result",
    "code",
    "message",
    "limits",
    "durationMillis",
    "network"
  ],
  "properties": {
    "schema": { "const": "com.krauq.ufo.combine-receipt" },
    "schemaVersion": { "const": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "action": { "const": "combine" },
    "status": { "enum": ["completed", "refused", "failed"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "name",
          "sizeBytes",
          "lastModifiedMillis",
          "sha256",
          "stableDuringProcessing",
          "pages",
          "selected"
        ],
        "properties": {
          "path": { "type": "string" },
          "name": { "type": "string" },
          "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
          "lastModifiedMillis": { "type": ["integer", "null"], "minimum": 0 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "stableDuringProcessing": { "type": ["boolean", "null"] },
          "pages": {
            "description": "The page selection as the caller gave it; `all` when none was given.",
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "description": "Pages this source contributed; null when nothing was combined.",
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sizeBytes", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sizeBytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        { "type": "null" }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "pages", "dropped"],
          "properties": {
            "engine": { "const": "pdf-combine" },
            "pages": { "type": "integer", "minimum": 1, "maximum": 5000 },
            "dropped": {
              "description": "Document-level features a source carried that a merged document cannot keep.",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "outlines",
                  "form_fields",
                  "named_destinations",
                  "page_labels",
                  "open_actions",
                  "links_to_pages_left_out"
                ]
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "code": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSourceBytes",
        "maxInputs",
        "maxInputPages",
        "maxOutputPages",
        "maxOutputBytes",
        "workerTimeoutMillis",
        "workerMaxHeapMiB"
      ],
      "properties": {
        "maxSourceBytes": { "type": "integer", "minimum": 1 },
        "maxInputs": { "type": "integer", "minimum": 2 },
        "maxInputPages": { "type": "integer", "minimum": 1 },
        "maxOutputPages": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "workerTimeoutMillis": { "type": "integer", "minimum": 1 },
        "workerMaxHeapMiB": { "type": "integer", "minimum": 1 }
      }
    },
    "durationMillis": { "type": "integer", "minimum": 0 },
    "license": {
      "description": "The licence this run was under: tier free and verified false when no licence file applied. Optional, so a receipt from a build older than the licence file still validates. It records a fact about the run and never marks, degrades or qualifies the work the receipt describes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "organization", "expiresAt", "keyId", "source", "verified", "note"],
      "properties": {
        "tier": { "enum": ["free", "organization-50", "organization-500", "organization-unbounded"] },
        "organization": { "type": ["string", "null"] },
        "expiresAt": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "keyId": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "verified": { "type": "boolean" },
        "note": { "type": ["string", "null"] }
      }
    },
    "network": { "const": "not_used" }
  }
}
