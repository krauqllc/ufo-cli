{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krauq.com/schemas/ufo-xlsx-cells-v1.schema.json",
  "title": "UFO XLSX sheet inventory and cell range v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "source",
    "sheets",
    "selection",
    "partial",
    "scope"
  ],
  "properties": {
    "schema": {
      "const": "com.krauq.ufo.xlsx-cells"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "name",
          "part",
          "visibility",
          "dimension",
          "dimensionSource",
          "charts",
          "chartsComplete",
          "validations",
          "validationsComplete",
          "conditionalFormats",
          "conditionalFormatsComplete"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31
          },
          "part": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "enum": [
              "visible",
              "hidden",
              "veryhidden"
            ]
          },
          "dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimensionSource": {
            "enum": [
              "declared",
              "computed",
              null
            ]
          },
          "storedDimension": {
            "description": "Actual stored-cell extent, independent of the declared dimension; null for an empty or unreadable worksheet. Optional for older v1 reads.",
            "type": ["string", "null"],
            "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"
          },
          "charts": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "part",
                "title",
                "type",
                "series"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1
                },
                "part": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                },
                "type": {
                  "enum": [
                    "bar",
                    "line",
                    "pie",
                    "area",
                    "scatter",
                    "other"
                  ]
                },
                "series": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "maxLength": 255
                  }
                }
              }
            }
          },
          "chartsComplete": {
            "type": "boolean"
          },
          "validations": {
            "description": "Every data validation the worksheet declares, as the cells it covers and its type, in document order.",
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/$defs/rule" }
          },
          "validationsComplete": {
            "type": "boolean"
          },
          "conditionalFormats": {
            "description": "Every conditional-formatting rule the worksheet declares, as the cells it covers and its type, in document order; a block carrying several rules reports one row per rule.",
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/$defs/rule" }
          },
          "conditionalFormatsComplete": {
            "type": "boolean"
          }
        }
      }
    },
    "selection": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "sheet",
        "part",
        "range",
        "cells"
      ],
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "part": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "row",
              "column",
              "type",
              "value",
              "formula",
              "cachedValue",
              "limitation"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
              },
              "row": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "type": {
                "enum": [
                  "empty",
                  "string",
                  "number",
                  "boolean",
                  "error",
                  "date",
                  "formula"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 32767
              },
              "formula": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cachedValue": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 32767
              },
              "limitation": {
                "enum": [
                  null,
                  "shared_formula_dependent",
                  "array_formula",
                  "shared_string_missing",
                  "value_length_limit",
                  "boolean_value_invalid"
                ]
              },
              "valueLimitation": {
                "description": "Why a stored value or formula cache cannot be read, independent of formula edit restrictions. Optional for older v1 reads.",
                "enum": [null, "shared_string_missing", "value_length_limit", "boolean_value_invalid"]
              },
              "editable": {
                "type": "boolean",
                "description": "Whether this cell is a supported guarded write target. Source hash, preimage, value and whole-package gates still apply. Older v1 cells may omit this assessment."
              },
              "editRefusal": {
                "type": ["string", "null"],
                "minLength": 1,
                "description": "Static target restriction, or null when none was found; paired with editable when present."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "formula"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "formula": {
                      "type": "null"
                    },
                    "cachedValue": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "empty"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": { "required": ["editable"] },
                "then": {
                  "required": ["editRefusal"],
                  "if": { "properties": { "editable": { "const": true } } },
                  "then": {
                    "properties": {
                      "editRefusal": { "type": "null" },
                      "limitation": { "type": "null" },
                      "type": { "enum": ["empty", "string", "number", "boolean", "formula"] }
                    }
                  },
                  "else": { "properties": { "editRefusal": { "type": "string" } } }
                }
              },
              {
                "if": { "required": ["editRefusal"] },
                "then": { "required": ["editable"] }
              }
            ]
          }
        }
      }
    },
    "partial": {
      "type": "boolean"
    },
    "scope": {
      "const": "worksheet cells by address; formula values are as saved, not recalculated; merged ranges, styles, comments and drawings are not read"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sqref", "type"],
      "properties": {
        "sqref": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
