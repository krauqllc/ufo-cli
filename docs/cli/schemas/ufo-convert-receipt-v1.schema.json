        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "target",
            "sourcePages",
            "paragraphs",
            "characters",
            "rows",
            "columns",
            "cells",
            "slides",
            "scope"
          ],
          "properties": {
