            "engine",
            "target",
            "sourcePages",
            "paragraphs",
            "characters",
            "rows",
            "columns",
            "cells",
            "slides",
            "scope"
          ],
          "properties": {
            "engine": {
              "const": "pdf-page-pptx"
            },
            "target": {
              "const": "pptx"
            },
            "sourcePages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "paragraphs": {
              "type": "null"
            },
            "characters": {
              "type": "null"
            },
            "rows": {
              "type": "null"
            },
            "columns": {
              "type": "null"
            },
            "cells": {
              "type": "null"
            },
            "slides": {
              "type": "integer",
