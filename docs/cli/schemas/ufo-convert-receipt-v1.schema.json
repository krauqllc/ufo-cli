    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyLimits"
        },
        {
          "$ref": "#/$defs/pdfOfficeLimits"
        },
        {
          "$ref": "#/$defs/nativeCompleteLimits"
        },
        {
          "$ref": "#/$defs/nativeChartLimits"
        },
        {
          "$ref": "#/$defs/statisticsLimits"
