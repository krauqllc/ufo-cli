            "startRow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "partial": {
              "type": "boolean"
            },
            "labels": {
              "type": "boolean"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "notice": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "target": {
                    "enum": [
                      "txt",
                      "md",
                      "opml"
