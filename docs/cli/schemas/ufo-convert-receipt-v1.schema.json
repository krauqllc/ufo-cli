              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "cells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "slides": {
              "type": "null"
            },
            "scope": {
              "const": "selected_table_literal_text"
