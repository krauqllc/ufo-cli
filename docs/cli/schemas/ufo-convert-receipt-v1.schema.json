              "const": "docx"
            },
            "sourcePages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "paragraphs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "characters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "rows": {
              "type": "null"
            },
            "columns": {
              "type": "null"
            },
            "cells": {
              "type": "null"
            },
            "slides": {
              "type": "null"
            },
