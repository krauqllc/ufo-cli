            "target": {
              "enum": [
                "geojson",
                "kml",
                "gpx",
                "png",
                "svg"
              ]
            },
            "notices": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(?:(?:Limit|MissingDbf|Unsupported|ImagesOmitted|UnknownCrs)(?:,(?:Limit|MissingDbf|Unsupported|ImagesOmitted|UnknownCrs))*)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "pages",
            "raster",
            "dpi",
            "entities",
            "partial"
