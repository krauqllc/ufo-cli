            "dpi": {
              "type": "null"
            },
            "note": {
              "const": "Text conversion reflows readable text. Images, original layout, annotations and interactive content are omitted. Scanned pages need OCR."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
