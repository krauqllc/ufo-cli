            "raster": {
              "type": "boolean"
            },
            "dpi": {
              "type": "null"
            },
            "entities": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "partial": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "engine": {
                    "const": "cad-dxf-vector"
                  }
                }
              },
              "then": {
                "properties": {
                  "raster": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "engine": {
                    "const": "cad-dxf-raster"
                  }
                }
              },
              "then": {
                "properties": {
                  "raster": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "target",
            "partial",
            "tables",
            "sha256",
            "notice"
          ],
          "properties": {
            "engine": {
              "const": "access-table-copy"
            },
            "target": {
              "enum": [
                "csv",
                "xlsx"
              ]
            },
            "partial": {
              "type": "boolean"
            },
            "tables": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "rows",
                  "sourceRows"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000
                  },
                  "sourceRows": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000000
                  }
                }
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "notice": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "target",
            "frames",
            "sha256"
          ],
          "properties": {
            "engine": {
              "const": "dicom-image"
            },
            "target": {
              "enum": [
                "png",
                "jpg",
                "gif",
                "pdf",
                "csv",
                "json"
              ]
            },
            "frames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
