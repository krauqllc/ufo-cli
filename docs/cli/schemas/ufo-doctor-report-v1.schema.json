{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krauq.com/schemas/ufo-doctor-report-v1.schema.json",
  "title": "UFO installation self-check report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "engineVersion", "status", "network", "checks"],
  "properties": {
    "schema": {"const": "com.krauq.ufo.doctor-report"},
    "schemaVersion": {"const": 1},
    "engineVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed"]},
    "license": {
      "description": "The licence this run was under: tier free and verified false when no licence file applied. Optional, so a receipt from a build older than the licence file still validates. It records a fact about the run and never marks, degrades or qualifies the work the receipt describes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "organization", "expiresAt", "keyId", "source", "verified", "note"],
      "properties": {
        "tier": { "enum": ["free", "organization-50", "organization-500", "organization-unbounded"] },
        "organization": { "type": ["string", "null"] },
        "expiresAt": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "keyId": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "verified": { "type": "boolean" },
        "note": { "type": ["string", "null"] }
      }
    },
    "network": {"const": "not_used"},
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "allOf": [{"prefixItems": [
        {"properties": {"name": {"const": "temporary_workspace"}}},
        {"properties": {"name": {"const": "worker_intake"}}},
        {"properties": {"name": {"const": "text_copy_out"}}},
        {"properties": {"name": {"const": "output_no_replace"}}},
        {"properties": {"name": {"const": "source_preservation"}}},
        {"properties": {"name": {"const": "temporary_cleanup"}}}
      ]}],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["passed", "failed", "skipped"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "passed"}}},
    "then": {"properties": {"checks": {"items": {"properties": {"status": {"const": "passed"}}}}}},
    "else": {"properties": {"checks": {"contains": {"properties": {"status": {"const": "failed"}}}}}}
  }]
}
