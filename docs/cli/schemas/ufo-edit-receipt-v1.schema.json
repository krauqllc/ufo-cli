{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krauq.com/schemas/ufo-edit-receipt-v1.schema.json",
  "title": "UFO edit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "engineVersion",
    "sequence",
    "action",
    "operation",
    "status",
    "source",
    "output",
    "result",
    "plan",
    "code",
    "message",
    "limits",
    "durationMillis",
    "network"
  ],
  "properties": {
    "schema": {
      "const": "com.krauq.ufo.edit-receipt"
    },
    "schemaVersion": {
      "const": 1
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "const": "edit"
    },
    "operation": {
      "enum": [
        "rotate",
        "pages",
        "metadata",
        "accept-changes",
        "reject-changes",
        "replace-text",
        "cells",
        "rows",
        "archive",
        "stamp",
        "form",
        "paragraphs",
        "tables",
        "slides",
        "fields",
        "image",
        "image-insert",
        "image-replace",
        "chart",
        "lines",
        "format",
        "pdf-text",
        "merge",
        "sheets",
        "annotate",
        "shapes",
        "columns",
        "layout",
        "chart-create",
        "slide-table",
        "rules"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "planned",
        "refused",
        "failed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "sizeBytes",
        "lastModifiedMillis",
        "sha256",
        "stableDuringProcessing"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "lastModifiedMillis": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stableDuringProcessing": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sizeBytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "applied",
            "skipped",
            "outputExtension"
          ],
          "properties": {
            "engine": {
              "enum": [
                "pdf-pages",
                "pdf-info",
                "office-properties",
                "office-clean",
                "id3",
                "image-scrub",
                "docx-revisions",
                "docx-text",
                "pptx-text",
                "xlsx-text",
                "text",
                "xlsx-cells",
                "xlsx-rows",
                "ods-cells",
                "zip-entries",
                "tar-entries",
                "7z-entries",
                "pdf-stamps",
                "pdf-forms",
                "docx-paragraphs",
                "docx-tables",
                "docx-images",
                "docx-charts",
                "pptx-slides",
                "pptx-deck",
                "pptx-images",
                "pptx-charts",
                "json-fields",
                "csv-fields",
                "image-raster",
                "text-lines",
                "docx-format",
                "pptx-format",
                "xlsx-format",
                "pdf-text",
                "docx-merge",
                "pptx-merge",
                "xlsx-merge",
                "xlsx-sheets",
                "pdf-annotations",
                "pptx-shapes",
                "xlsx-columns",
                "xlsx-layout",
                "xlsx-charts",
                "pptx-tables",
                "xlsx-rules"
              ]
            },
            "applied": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "count",
                  "detail"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "page_rotated",
                      "page_kept",
                      "page_deleted",
                      "page_reordered",
                      "metadata_set",
                      "metadata_cleared",
                      "metadata_stripped",
                      "revisions_accepted",
                      "revisions_rejected",
                      "text_replaced",
                      "cell_written",
                      "formula_written",
                      "row_appended",
                      "row_inserted",
                      "row_deleted",
                      "entry_added",
                      "entry_removed",
                      "watermark_added",
                      "text_stamped",
                      "page_numbers_added",
                      "field_set",
                      "paragraph_written",
                      "field_written",
                      "paragraph_tracked",
                      "paragraph_inserted",
                      "paragraph_deleted",
                      "paragraph_inserted_tracked",
                      "paragraph_deleted_tracked",
                      "comment_added",
                      "comment_replied",
                      "comment_resolved",
                      "comment_deleted",
                      "table_row_copied",
                      "table_row_deleted",
                      "slide_duplicated",
                      "slide_deleted",
                      "orientation_normalized",
                      "image_cropped",
                      "image_resized",
                      "image_rotated",
                      "image_inserted",
                      "image_replaced",
                      "chart_series_written",
                      "line_written",
                      "paragraph_styled",
                      "format_applied",
                      "pdf_paragraph_written",
                      "field_merged",
                      "block_repeated",
                      "sheet_added",
                      "sheet_renamed",
                      "sheet_deleted",
                      "sheet_copied",
                      "annotation_added",
                      "slide_moved",
                      "shape_added",
                      "shape_deleted",
                      "column_inserted",
                      "column_deleted",
                      "cells_merged",
                      "cells_unmerged",
                      "panes_frozen",
                      "panes_unfrozen",
                      "column_width_set",
                      "row_height_set",
                      "link_added",
                      "link_removed",
                      "footnote_added",
                      "chart_created",
                      "table_cell_written",
                      "validation_added",
                      "conditional_format_added",
                      "rules_cleared"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "detail": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "skipped": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "category",
                  "reason"
                ],
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "outputExtension": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]{1,16}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unusedKeys": {
              "description": "Merge only: supplied keys the template never used. Not an error; the run completes.",
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "missingKeys": {
              "description": "Merge only: placeholders the data had no key for, kept or emptied as --missing asked.",
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "stamp": {
              "description": "UFO's provenance stamp, present when a Word, Excel or PowerPoint output carries it: the custom properties written and every package member the stamp wrote. --no-stamp writes none.",
              "type": "object",
              "additionalProperties": false,
              "required": ["properties", "parts"],
              "properties": {
                "properties": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 3,
                  "propertyNames": { "enum": ["UFO.Version", "UFO.SourceSha256", "UFO.LastModified"] },
                  "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
                },
                "parts": {
                  "type": "array",
                  "maxItems": 3,
                  "items": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "description": "A dry run only: what the same command without --dry-run would publish. Null on every other receipt.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outputSha256",
            "outputSizeBytes"
          ],
          "properties": {
            "outputSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "outputSizeBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSourceBytes",
        "workerTimeoutMillis",
        "workerMaxHeapMiB"
      ],
      "properties": {
        "maxSourceBytes": {
          "const": 67108864
        },
        "workerTimeoutMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "workerMaxHeapMiB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048
        }
      }
    },
    "durationMillis": {
      "type": "integer",
      "minimum": 0
    },
    "license": {
      "description": "The licence this run was under: tier free and verified false when no licence file applied. Optional, so a receipt from a build older than the licence file still validates. It records a fact about the run and never marks, degrades or qualifies the work the receipt describes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "organization", "expiresAt", "keyId", "source", "verified", "note"],
      "properties": {
        "tier": { "enum": ["free", "organization-50", "organization-500", "organization-unbounded"] },
        "organization": { "type": ["string", "null"] },
        "expiresAt": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "keyId": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "verified": { "type": "boolean" },
        "note": { "type": ["string", "null"] }
      }
    },
    "network": {
      "const": "not_used"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "plan": {
            "type": "null"
          },
          "source": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "stableDuringProcessing": {
                "const": true
              }
            }
          },
          "code": {
            "type": "null"
          },
          "message": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "planned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          },
          "output": {
            "type": "null"
          },
          "plan": {
            "type": "object"
          },
          "source": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "stableDuringProcessing": {
                "const": true
              }
            }
          },
          "code": {
            "type": "null"
          },
          "message": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "refused",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "null"
          },
          "result": {
            "type": "null"
          },
          "plan": {
            "type": "null"
          }
        }
      }
    }
  ]
}
